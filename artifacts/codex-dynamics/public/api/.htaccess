# Codex Dynamics - API Router for Hostinger Shared Hosting
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/

  # If requested file or directory exists, serve directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other API requests to index.php
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Protect SQLite database files from browser downloads
<FilesMatch "\.(sqlite|sqlite3|db)$">
  Order deny,allow
  Deny from all
</FilesMatch>
