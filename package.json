{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/codex-dynamics",
    "build": "npm run build --workspace=@workspace/codex-dynamics",
    "test:api": "node --test scripts/admin-api.integration.test.mjs",
    "lint": "eslint artifacts/codex-dynamics/src",
    "typecheck": "npm run typecheck --workspace=@workspace/codex-dynamics",
    "package:hostinger": "node scripts/build-hostinger-zip.mjs",
    "create-admin": "php scripts/create-super-admin.php"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
